# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local) — FREE with local Ollama
LLM_PROVIDER=ollama           # openai | gemini | ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3:14b
OPENAI_API_KEY=ollama         # required-but-ignored by Ollama (do not put a real key)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_OUTPUT_DIR=output
LOCAL_WHISPER_VAD_FILTER=false

# --- Professional-output knobs (optional; these are the defaults) ---
# Clip length limits (cap 120s / floor 8s)
SHORTS_MAX_SECONDS=120
SHORTS_MIN_SECONDS=8
# Hook text: big bold title burned over the first 3s of every clip
HOOK_TEXT=true
HOOK_SECONDS=3
HOOK_FONT_SIZE=72
# Dynamic zoom: slow push-in across each clip (0.06 = 6%)
DYNAMIC_ZOOM=true
ZOOM_MAX=0.06
# Loudness normalization + locked frame rate
LOUDNESS_FILTER=loudnorm=I=-14:TP=-1.5:LRA=11
OUTPUT_FPS=30
# Source quality: prefer up to 1080p (falls back automatically)
DOWNLOAD_FORMAT=1080
# Caption styling: keyword emphasis; set SUBTITLE_LANGUAGE=en to force English
KEYWORD_EMPHASIS=true
SUBTITLE_LANGUAGE=
# --- Topic-shift segmentation (fixes merged clips) ---
# SEGMENTATION_SERVICE: off | semantic | auto (semantic + pause boundaries)
SEGMENTATION_SERVICE=auto
TOPIC_SIM_SIGMAS=0.5
PAUSE_BOUNDARY_SECONDS=1.2
SEGMENT_MIN_SECONDS=4
# Retry knobs (read by worker.py's transient-error path if you extend it)
# PIPE_RETRY_LIMIT=3
